---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Backlinks from '../../components/Backlinks.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import { getPosts, formatDate, slugifyTag } from '../../lib/content';
import { getLinkGraph, relatedTo } from '../../lib/graph';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;

// 必须在 render() 之前拿到：graph 模块会注入 wikilink 解析表
const graph = await getLinkGraph();
const { Content } = await render(post);

const backlinks = graph.backlinks.get(post.id) ?? [];

const descriptions = new Map((await getPosts()).map((p) => [p.id, p.data.description]));
const related = relatedTo(graph, post.id)
  .filter((slug) => descriptions.has(slug))
  .map((slug) => ({
    slug,
    title: graph.titles.get(slug) ?? slug,
    description: descriptions.get(slug) as string,
  }));
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article>
    <header class="article-header">
      <h1>{post.data.title}</h1>
      <div class="article-meta">
        {formatDate(post.data.pubDate)}
        {
          post.data.tags.length > 0 && (
            <>
              {' · '}
              {post.data.tags.map((tag, i) => (
                <>
                  {i > 0 && '、'}
                  <a href={`/tags/${slugifyTag(tag)}/`}>{tag}</a>
                </>
              ))}
            </>
          )
        }
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
    <a class="back-link" href="/blog">← 回到文章列表</a>

    <RelatedPosts items={related} />
    <Backlinks backlinks={backlinks} titles={graph.titles} />
  </article>
</BaseLayout>
