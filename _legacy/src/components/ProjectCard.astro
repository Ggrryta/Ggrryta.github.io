---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, summary, year, stack, role } = project.data;
---
<a class="card" href={`/projects/${project.id}/`}>
  <h3>{title}</h3>
  <p>{summary}</p>
  {
    stack.length > 0 && (
      <div class="stack">
        {stack.map((item) => (
          <span class="tag">{item}</span>
        ))}
      </div>
    )
  }
  <div class="card-meta">
    <span>{year}</span>
    {role && <span>&middot; {role}</span>}
  </div>
</a>
